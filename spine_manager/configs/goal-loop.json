    "migrationStatus": "4.3.26-exported-runtime-round-trip-pass",
    "rollbackEditor": "4.0.47",
    "rollbackRuntime": "@esotericsoftware/spine-canvas@4.0.31",
    "deferredVisualGatesAreNotPass": true,
    "provisionalRuntimePatchCannotRelease": true,
    "maxRepairRoundsPerFailure": 3
  },
  "priorityOrder": [
    "complete-c010-4.3.26-room-runtime-and-validate-actions",
    "replace-one-bone-hand-ik-and-isolate-strap-target",
    "run-independent-multimodal-review",
    "calibrate-texture-and-visual-gates",
    "prove-cold-start-and-rollback",
    "only-then-freeze-4.3.26-release-baseline"
  ]
