{
  "schemaVersion": 1,
  "goalId": "roomwave-c010-spine-closure",
  "manualActivation": true,
  "objective": "按spine_manager既定方案，把c010 Spine模型接入Roomwave的自动化构建、语义绑定、最小动作试作、纹理/视觉评估和启动验证闭环；每5轮重新读取方案与方法论文档，然后按顶尖专家的角度来复盘进展和思考推进方法。自动安装可用外部依赖。持续验证直到达到：语义动作正确、运动过程自然、角色结构和服装稳定、效果锚点可信、角色身份一致、直播交互清楚，并且经过确定性检查、逐帧轨迹分析和多角色视觉复核后，没有未解释的重大分歧。",
  "roomIntegration": {
    "productRoom": "gaming_c010",
    "productEntry": "/solo/?room=gaming_c010",
    "compatibilityEntry": "/solo/?spine=c010",
    "auditEntry": "/spine-audit/c010/",
    "baselineRoom": "/solo/",
    "baselineRoomMeaning": "原版 gaming-seated，只作对照，不被c010覆盖"
  },
  "reviewProtocol": {
    "reviewEveryTurns": 5,
    "reviewBeforeTurn": true,
    "checkpointCommand": "npm run goal:checkpoint -- --turn <N>",
    "turnCommand": "npm run goal:turn -- --turn <N>",
    "ledger": "artifacts/goal-loop/ledger.jsonl",
    "checkpointDirectory": "artifacts/goal-loop/checkpoints",
    "mustReadBeforeCheckpoint": [
      "docs/AUTOMATED-EXPERT-PIPELINE.md",
      "docs/MODEL-CONSTRUCTION-PLAN.md",
      "docs/DEBUG-LOOP.md",
      "docs/VISION-REVIEW-RUBRIC.md",
      "docs/RUNTIME-CONTRACT.md",
      "docs/ASSET-RECOVERY-AND-GENERATION.md",
      "docs/VERSION-MIGRATION.md",
      "configs/agent-pipeline.json",
      "configs/c010-control-plan.json",
      "configs/c010-version-migration.json",
      "configs/texture-gates.json",
      "configs/calibration.json",
      "configs/dependencies.json",
      "configs/room-action-matrix.json",
      "configs/visual-review-roles.json",
      "docs/EVIDENCE-PACKET.md"
    ],
    "mustInspectBeforeCheckpoint": [
      "configs/c010-validation-report.json",
      "tools/spine-tool.json",
      "evidence/c010/portable-cli-activation.json",
      "evidence/c010/portable-cli-export.json",
      "evidence/c010-editor-availability.json",
      "evidence/c010-cli-export-probe.json",
      "evidence/c010-editor-update-4.0.47.json",
      "evidence/c010-runtime-version-probe.json",
      "evidence/c010-migration-4.3.26-cli-probe.json",
      "evidence/c010-migration-runtime-staged.json",
      "evidence/c010-hand-reachability.json",
      "evidence/c010-hand-only-string-off.json",
      "evidence/c010-room-routing.json",
      "evidence/c010/review-manifest.json",
      "evidence/c010/trace-analysis.json",
      "artifacts/runs/*/evidence/runtime-hand-ik.json",
      "artifacts/dependency-check.json",
      "artifacts/runs/*/run-summary.json"
    ],
    "failClosedIf": [
      "required document is missing",
      "required evidence is missing",
      "latest run is older than the current checkpoint",
      "visual review is deferred or contradictory",
      "hard gate is not proven"
    ]
  },
  "completionStates": {
      "runtime-usable": {
      "meaning": "4.3.26 export loads in the current Roomwave runtime and the gaming_c010 room responds to the shared Gaming interaction contract.",
      "requiredChecks": ["startup-smoke", "runtime-smoke", "source-availability", "default-room-routing", "gaming-c010-room", "gaming-c010-actions", "trace-analysis", "legacy-gaming-room"]
    },
    "mutation-ready": {
      "meaning": "A project-local Spine editor or CLI can open the editable project and produce a controlled derived export.",
      "requiredChecks": ["cli-policy", "editor-availability", "editable-project-open", "portable-cli-roundtrip"]
    },
    "migration-validated": {
      "meaning": "The 4.3.26 candidate has its own saved project, matching 4.3 runtime export, and round-trip evidence.",
      "requiredChecks": ["migration-open", "migration-save", "migration-export", "runtime-4.3-round-trip"]
    },
    "release-ready": {
      "meaning": "The Roomwave release has independent control, visual, texture, version, startup and rollback evidence.",
      "requiredChecks": ["hand-only", "strap-only", "gun-only", "interrupt-recovery", "texture-gates", "independent-visual-review", "rollback-manifest"]
    }
  },
  "currentPolicy": {
    "baselineEditor": "4.3.26",
    "baselineRuntime": "@esotericsoftware/spine-canvas@4.3.13",
    "migrationCandidate": "4.3.26-export",
