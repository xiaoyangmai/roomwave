  "validation_gates": [
    {
      "id": "version",
      "hard": true,
      "checks": [
        "editor/export are 4.3.26",
        "runtime is 4.3.13",
        "major.minor compatibility is explicit"
      ]
    },
    {
      "id": "source_boundary",
      "hard": true,
      "checks": [
        "native source hash is recorded",
        "only a derived copy is mutated",
        "rollback pointer is present"
      ]
    },
    {
      "id": "structure",
      "hard": true,
      "checks": [
        "bones, slots, skins, attachments and constraints resolve",
        "no illegal IK target or chain",
        "constraint order changes are explained"
      ]
    },
    {
      "id": "roundtrip",
      "hard": true,
      "checks": [
        "Portable CLI export succeeds",
        "JSON/SKEL is readable",
        "atlas and all pages load in the declared runtime",
        "counts and named references are compared"
      ]
    },
    {
      "id": "semantic_isolation",
      "hard": true,
      "checks": [
        "hand-only",
        "strap-only",
        "gun-only",
        "hand-to-face"
      ]
    },
    {
      "id": "motion",
      "hard": true,
      "checks": [
        "interrupt-and-recover",
        "deterministic-replay",
        "event trace where events are used"
      ]
    },
    {
      "id": "visual",
      "hard": true,
      "checks": [
        "rest/contact/extreme/return poses",
        "identity, contact, deformation, occlusion and material review",
        "independent reviewer evidence"
      ]
    },
    {
      "id": "performance",
      "hard": true,
      "checks": [
        "fixed workload and FPS measurement",
        "no unrecorded runtime patch or asset fallback"
      ]
    }
  ],
  "unknown_policy": "unknown blocks promotion; resolve by running the smallest reproducible probe and recording its evidence",
  "mutation_policy": "plan first, mutate only a derived copy, export, read back, validate, then promote by manifest"
}
