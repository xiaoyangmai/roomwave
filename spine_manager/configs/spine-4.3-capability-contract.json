{
  "schema_version": 1,
  "contract_id": "roomwave-spine-4.3-capability-contract",
  "status": "partial-verified-live-stdio-named-tool-reload-pending",
  "scope": "Spine 4.3 editable projects, Portable CLI exports, JSON/SKEL readback and spine-canvas runtime validation",
  "authority": {
    "editable_source": "native .spine project",
    "export_readback": "JSON/SKEL plus atlas and texture pages",
    "runtime_readback": "@esotericsoftware/spine-canvas@4.3.13",
    "source_policy": "never replace the native .spine project with an export"
  },
  "version_boundary": {
    "editor": "4.3.26",
    "export": "4.3.26",
    "runtime": "4.3.13",
    "compatibility_rule": "editor and export must stay on 4.3; runtime must be an explicitly tested 4.3 runtime; do not infer compatibility from a file extension",
    "migration_evidence": "configs/c010-version-migration.json"
  },
  "baseline": {
    "model": "c010_00",
    "source_project": "source/nikke_4.3.26/derived/c010_roomwave_4.3.26/c010_roomwave_4.3.26.spine",
    "source_is_derived_copy": true,
    "counts": {
      "bones": 310,
      "slots": 141,
      "skins": 3,
      "animations": 10,
      "events": 1,
      "ik_constraints": 6,
      "transform_constraints": 60,
      "path_constraints": 0,
      "mesh_attachments": 264,
      "weighted_mesh_attachments": 212,
      "atlas_pages": 4,
      "atlas_regions": 328
    },
    "counts_are": "baseline evidence, not a promise that every future model has the same counts"
  },
  "support_levels": {
    "full": "The surface can inspect or perform the operation within this contract and the result is covered by a deterministic gate.",
    "partial": "The operation is possible only through a constrained path, such as a derived copy, a validated JSON round-trip or a named feature subset.",
    "read_only": "Facts can be read and checked, but this surface must not be used to author or mutate the capability.",
    "not_supported": "The surface is intentionally outside the operation boundary.",
    "unknown": "The tool or version has not yet produced evidence; treat it as blocked until verified."
  },
  "surfaces": {
    "native_project": {
      "format": ".spine",
      "role": "authoritative editable source",
      "mutation_policy": "derived-copy-only",
      "operator": "Spine Editor 4.3.26 or a verified project-local editor/CLI path"
    },
    "portable_cli": {
      "format": "Spine JSON/SKEL export and import",
      "role": "deterministic export/import bridge",
      "operator": "tools/run-spine-portable-cli.ps1",
      "activation_policy": "invoke the Portable launcher/profile bridge; direct app/Spine.com invocation is forbidden"
    },
    "exported_skeleton": {
      "format": ".json or .skel plus .atlas and texture pages",
      "role": "readback and runtime input",
      "source_policy": "derived evidence; never the only editable source"
    },
    "runtime": {
      "package": "@esotericsoftware/spine-canvas@4.3.13",
      "role": "independent load, pose, timeline and replay evidence"
    },
    "local_mcp": {
      "role": "optional assistant tools for inspection or controlled operations",
      "status": "partial-verified",
      "evidence_required": "tool discovery plus a c010 readback; no MCP claim is a pass by installation alone",
      "bindings": {
        "spine_1425sd": {
          "status": "verified-read-only",
          "tools": [
            "spine_analyze_json"
          ],
          "verified_operations": [
            "inspect"
          ],
          "mutation_support": "not_supported",
          "evidence": "runs/foundation-baseline-20261029/mcp-1425sd-analyze-evidence.json",
          "verified_at": "2026-10-30"
        },
        "spine_egorfedorov": {
          "status": "verified-stdio-named-tool-reload-pending",
          "transport_status": {
            "server_stdio": "verified",
            "codex_named_tool": "disconnected-after-adapter-reload",
            "last_error": "The Codex adapter connection was closed while reloading the updated direct Portable launcher path"
          },
          "tools": [
            "spine_doctor",
            "make_project",
            "export_project"
          ],
          "verified_operations": [
            "portable-bridge-doctor",
            "derived-project-import",
            "derived-project-export"
          ],
          "mutation_support": "partial-derived-only",
          "evidence": "runs/foundation-baseline-20261029/mcp-egorfedorov-live-codex-final.json",
          "historical_evidence": "runs/foundation-baseline-20261029/mcp-egorfedorov-portable-bridge-evidence.json",
          "current_live_attempt": "runs/foundation-baseline-20261029/mcp-egorfedorov-live-codex-final.json",
          "verified_at": "2026-10-30",
          "limits": [
            "MCP stdio import and export are verified through the direct Portable launcher path",
            "the Codex named-tool adapter must reconnect once before its live import and export status can be claimed",
            "project_info produced no stdout summary from this CLI build",
            "texture export was not verified from the JSON-only probe; the generated atlas is empty without an image directory"
          ]
        }
      }
    }
  },
  "operations": {
    "inspect": "read names, counts, references, geometry metadata and version facts with file/hash evidence",
    "mutate": "change a derived native project or a narrowly scoped JSON candidate, then export and read it back",
    "export_roundtrip": "export from the derived project, reload with the declared runtime and compare structure",
    "pose_validate": "evaluate fixed golden poses, extreme poses and semantic isolation cases",
    "replay_validate": "replay a fixed action sequence at a fixed FPS/viewport/seed and compare traces",
    "visual_validate": "independent evidence review of identity, contact, deformation, materials and artifacts"
  },
