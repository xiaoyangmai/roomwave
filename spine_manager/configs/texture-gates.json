{
  "schemaVersion": 1,
  "note": "Provisional guardrails. Calibrate against a c010 reference set; do not treat any single threshold as ground truth.",
  "thresholdPolicy": {
    "mode": "calibrated",
    "status": "provisional",
    "referenceSet": "pending-c010-approved-frames",
    "adjustmentRule": "fit_to_reference_distribution_then_review_outliers",
    "hardGatesMayNotBeRelaxedFor": ["mask_outside_mutation", "alpha_contamination", "runtime_crash", "version_mismatch"],
    "softGatesMayBeAdjustedFor": ["silhouette", "identity", "material", "flicker"]
  },
  "hard": {
    "maskOutsideChangedPixelRatioMax": 0.001,
    "maskOutsideRgbDeltaMax": 2,
    "alphaOutsideChangedPixelRatioMax": 0,
    "boundaryConnectedComponentDeltaMax": 0,
    "edgeRingDeltaE95Max": 6,
    "edgeRingSsimMin": 0.95,
    "poseKeypointDropoutRatioMax": 0.02,
    "frameFlickerMeanMax": 0.03,
    "frameFlickerP95Max": 0.08
  },
  "soft": {
    "silhouetteIoUMin": 0.98,
    "boundaryHausdorffPxMax": 2,
    "identityEmbeddingCosineMin": 0.9,
    "materialSimilarityMaxLpips": 0.25
  },
  "modelAssisted": {
    "judgeCount": 2,
    "disagreementMaxPoints": 1,
    "dimensions": [
      "action_readability",
      "hand_contact_plausibility",
      "identity_and_costume_consistency",
      "occlusion_and_layer_order",
      "anatomy_and_artifact_risk",
      "overall_human_view"
    ],
    "scale": [1, 5],
    "requiresEvidenceReferences": true,
    "cannotOverride": ["mask_outside_mutation", "alpha_contamination", "runtime_crash", "version_mismatch"]
  },
  "policy": {
    "candidateSeedsPerPatch": 8,
    "maxRepairRounds": 3,
    "rejectIfAnyHardGateFails": true,
    "rejectIfSoftScoreUncertain": true,
    "neverChooseOnlyByOverallScore": true
  },
  "evaluator": {
    "command": "python tools/check-texture-gates.py --base <base.png> --candidate <candidate.png> --mask <mask.png>",
    "implementedDeterministicGates": ["mask_outside_mutation", "mask_outside_rgb_delta", "alpha_contamination", "edge_ring_ssim", "silhouette_iou", "frame_flicker_mean", "frame_flicker_p95"],
    "deferredGates": ["identity_embedding", "material_similarity", "model_assisted_review"],
    "deferredGatesMustNotBeReportedAsPass": true
  }
}
