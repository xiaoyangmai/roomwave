{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex operator envelope",
  "type": "object",
  "required": ["schema_version", "run_id", "operator", "delegations", "tool_calls"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "operator": { "type": "string", "const": "codex-root" },
    "mode": { "type": "string", "const": "assistant-operated" },
    "delegations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "status", "read_only"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "task": { "type": "string" },
          "input_artifacts": { "type": "array", "items": { "type": "string" } },
          "output_artifact": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["planned", "running", "passed", "blocked", "failed"] },
          "read_only": { "type": "boolean", "const": true },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "stage", "status"],
        "properties": {
          "tool": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["planned", "passed", "blocked", "failed"] },
          "input": { "type": "array", "items": { "type": "string" } },
          "output_artifacts": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "versions": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
