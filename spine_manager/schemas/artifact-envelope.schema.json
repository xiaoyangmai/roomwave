{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roomwave://spine-studio/artifact-envelope.schema.json",
  "title": "Spine Studio Artifact Envelope",
  "type": "object",
  "required": ["schema_version", "run_id", "stage", "created_at", "inputs", "status"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["draft", "passed", "failed", "blocked", "unknown"]},
    "facts": {"type": "array", "items": {"type": "object"}},
    "inferences": {"type": "array", "items": {"type": "object"}},
    "unknowns": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "failure_class": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
