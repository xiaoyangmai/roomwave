{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roomwave://spine-studio/rig-contract.schema.json",
  "title": "Semantic Rig Contract",
  "type": "object",
  "required": ["schema_version", "model", "targets", "isolation_cases"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "model": {"type": "string", "minLength": 1},
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "intent", "min", "default", "max", "must_not_control"],
        "properties": {
          "id": {"type": "string"},
          "intent": {"type": "string"},
          "min": {"type": ["number", "null"]},
          "default": {"type": ["number", "null"]},
          "max": {"type": ["number", "null"]},
          "must_not_control": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "isolation_cases": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
